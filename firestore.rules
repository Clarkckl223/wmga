rules_version = '2';
// 围棋复盘本的 Firestore 规则：复制全部内容，贴到 Firebase 控制台 → Firestore Database → 规则 → 发布
// 身份：accounts/{uid}.role = pending（等批准的老师）/ teacher / admin / student / revoked / denied
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function small() {
      return !('sgf' in request.resource.data) || (request.resource.data.sgf is string && request.resource.data.sgf.size() < 900000);
    }
    function acctPath(uid) { return /databases/$(database)/documents/accounts/$(uid); }
    function hasAcct() { return signed() && exists(acctPath(request.auth.uid)); }
    function me() { return get(acctPath(request.auth.uid)).data; }
    function isAdmin() {
      return signed() && request.auth.token.email == 'clarkckl223@gmail.com' && request.auth.token.email_verified == true;
    }
    function isTeacher() { return isAdmin() || (hasAcct() && me().role in ['teacher', 'admin']); }
    function isStudent() { return hasAcct() && me().role == 'student'; }
    function stu() { return get(/databases/$(database)/documents/students/$(me().sid)).data; }
    function metaPath(gid) { return /databases/$(database)/documents/games/$(gid)/layers/meta; }
    function ownsClass(gid) {
      return isTeacher() && exists(metaPath(gid)) && get(metaPath(gid)).data.get('owner', '') == request.auth.uid;
    }
    function inClass(gid) { return isStudent() && gid in stu().get('gids', []); }
    // 班级设定（meta）、练习册（b_…）、内建练习册的修改（x_…）：只有建立班级的老师能改
    function teacherDoc(name) { return name == 'meta' || name.matches('b_.*') || name.matches('x_.*'); }
    function teacherOk(gid) {
      return !exists(metaPath(gid))
        || !('owner' in get(metaPath(gid)).data)
        || get(metaPath(gid)).data.owner == request.auth.uid;
    }

    // ---- 账号 ----
    match /accounts/{uid} {
      allow get: if signed() && (request.auth.uid == uid || isTeacher());
      allow list: if isAdmin();
      allow create: if signed() && (
        (request.auth.uid == uid && request.resource.data.role == 'pending')
        || (request.auth.uid == uid && request.resource.data.role == 'admin' && isAdmin())
        || (isTeacher() && request.resource.data.role == 'student'));
      allow update: if isAdmin()
        || (request.auth.uid == uid && request.resource.data.role == resource.data.role)
        || (isTeacher() && resource.data.role == 'student' && request.resource.data.role in ['student', 'revoked']);
      allow delete: if false;
    }
    // 用户名 → 登录用的电邮（登录前要查，所以登录前的匿名连线也能读单一个，不能列出）
    match /logins/{u} {
      allow get: if signed();
      allow list: if false;
      allow create, update: if isTeacher();
      allow delete: if isTeacher(); // 改用户名、永久删除后，旧用户名可以再用
    }
    // 学生：在哪些班、每班的纪录文件
    match /students/{sid} {
      allow get: if isTeacher() || (isStudent() && me().sid == sid);
      allow list: if false;
      allow create, update: if isTeacher();
      allow delete: if false;
    }

    // ---- 申请：老师的新文件夹、上载全站的练习册；管理员审核 ----
    match /reqs/{id} {
      allow create: if signed() && small() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow get, list: if isAdmin() || (signed() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (signed() && small() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // ---- 考卷成绩：学生自己交；自己、班级老师、管理员看得到；只有管理员能改或删 ----
    match /exres/{id} {
      allow create: if signed() && small() && request.resource.data.uid == request.auth.uid;
      allow get, list: if isAdmin() || (signed() && resource.data.uid == request.auth.uid)
        || (signed() && resource.data.cls is string && resource.data.cls.matches('cls_.*') && ownsClass(resource.data.cls));
      allow update, delete: if isAdmin();
    }

    // ---- 问题回报：谁都能交（含访客匿名登录）；自己和管理员看得到；只有管理员能改状态、回复、删除 ----
    match /bugs/{id} {
      allow create: if signed() && small() && request.resource.data.uid == request.auth.uid
        && request.resource.data.st == 'new' && request.resource.data.reply == ''
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() < 420000))
        && request.resource.data.text is string && request.resource.data.text.size() <= 3000;
      allow get, list: if isAdmin() || (signed() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---- 网课课堂：老师和管理员开课；本班学生（或开放给所有人）可以进入 ----
    function room(rid) { return get(/databases/$(database)/documents/rooms/$(rid)).data; }
    function roomOk(r) { return isAdmin() || r.teacher == request.auth.uid || r.open == true
      || (r.cls is string && r.cls.matches('cls_.*') && (ownsClass(r.cls) || inClass(r.cls))); }
    function roomT(rid) { return isAdmin() || room(rid).teacher == request.auth.uid; }
    match /rooms/{rid} {
      allow read: if signed() && roomOk(resource.data);
      allow create: if signed() && isTeacher() && request.resource.data.teacher == request.auth.uid;
      allow update: if signed() && (isAdmin() || resource.data.teacher == request.auth.uid) && request.resource.data.teacher == resource.data.teacher;
      allow delete: if isAdmin();
      match /live/{d} {
        allow read: if signed() && roomOk(room(rid));
        allow write: if signed() && roomT(rid) && small();
      }
      match /people/{uid} {
        allow read: if signed() && roomOk(room(rid));
        allow write: if signed() && ((request.auth.uid == uid && roomOk(room(rid))) || roomT(rid));
      }
      match /ctl/{uid} {
        allow read: if signed() && roomOk(room(rid));
        allow write: if signed() && request.auth.uid == uid && roomOk(room(rid));
      }
      match /ans/{uid} {
        allow read: if signed() && roomOk(room(rid));
        allow write: if signed() && request.auth.uid == uid && roomOk(room(rid));
        allow delete: if signed() && roomT(rid);
      }
      match /chat/{id} {
        allow read: if signed() && roomOk(room(rid));
        allow create: if signed() && roomOk(room(rid)) && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 100
          && (room(rid).chatOff != true || roomT(rid));
        allow delete: if signed() && roomT(rid);
      }
    }

    // ---- 比赛和联赛（第 31 项）：只有主办和管理员能改；每次修改都要在同一笔写一笔修改记录 ----
    function tlogOk(tid) {
      return existsAfter(/databases/$(database)/documents/tlog/$(request.resource.data.lastLog))
        && getAfter(/databases/$(database)/documents/tlog/$(request.resource.data.lastLog)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/tlog/$(request.resource.data.lastLog)).data.tid == tid;
    }
    match /tours/{tid} {
      allow read: if signed();
      allow create: if signed() && isTeacher() && request.resource.data.org == request.auth.uid && tlogOk(tid);
      allow update: if signed() && (resource.data.org == request.auth.uid || isAdmin())
        && request.resource.data.org == resource.data.org
        && request.resource.data.lastLog != resource.data.lastLog && tlogOk(tid);
      allow delete: if false;
      // 参赛者自己的报名单：报名、退出、按名字认领（由主办合并）
      match /reg/{uid} {
        allow read: if signed();
        allow write: if signed() && request.auth.uid == uid;
        allow delete: if signed() && (request.auth.uid == uid || get(/databases/$(database)/documents/tours/$(tid)).data.org == request.auth.uid || isAdmin());
      }
    }
    // 修改记录：只能新增，不能修改、不能删除；时间是伺服器时间
    match /tlog/{lid} {
      allow create: if signed() && request.resource.data.uid == request.auth.uid && request.resource.data.t == request.time
        && request.resource.data.tid is string && request.resource.data.desc is string && request.resource.data.desc.size() <= 3000
        && request.resource.data.before is string && request.resource.data.before.size() < 300000;
      allow read: if isAdmin() || (signed() && resource.data.tid is string
        && get(/databases/$(database)/documents/tours/$(resource.data.tid)).data.org == request.auth.uid);
      allow update, delete: if false;
    }

    // ---- 观战 AI 解说（第 34 项）：解说机（老师 / 管理员）写；对局者本人（pB / pW）读不到；观战区聊天也一样 ----
    function notPlayer(d) { return d.pB != request.auth.uid && d.pW != request.auth.uid; }
    match /olai/{gid} {
      allow read: if signed() && (resource == null || notPlayer(resource.data));
      allow create, update: if signed() && isTeacher() && request.resource.data.host == request.auth.uid
        && notPlayer(request.resource.data) && request.resource.data.ev is string && request.resource.data.ev.size() < 300000
        && (resource == null || (request.resource.data.pB == resource.data.pB && request.resource.data.pW == resource.data.pW));
      allow delete: if false;
      match /chat/{id} {
        allow read: if signed() && notPlayer(get(/databases/$(database)/documents/olai/$(gid)).data);
        allow create: if signed() && notPlayer(get(/databases/$(database)/documents/olai/$(gid)).data)
          && request.resource.data.uid == request.auth.uid && request.resource.data.m is string && request.resource.data.m.size() <= 200;
        allow update, delete: if false;
      }
    }

    // ---- 棋谱分享、线上对弈、家里电脑（不是班级）：维持原来的做法 ----
    // wmga_global：内建练习册的「全站原版」修改，大家都能读，只有管理员能改
    match /games/{gid} {
      allow read: if signed() && (!gid.matches('cls_.*') || ownsClass(gid) || inClass(gid) || isAdmin());
      allow create, update: if signed() && small() && gid != 'wmga_global';
      allow delete: if false;

      match /layers/{name} {
        // 不是班级：登录（含匿名）就可以
        allow read: if signed() && !gid.matches('cls_.*');
        allow create, update: if signed() && small() && !gid.matches('cls_.*') && gid != 'wmga_global';
        allow create, update: if gid == 'wmga_global' && isAdmin() && small();
        // 班级：老师、这班的学生、管理员可以读
        allow read: if signed() && gid.matches('cls_.*') && (ownsClass(gid) || inClass(gid) || isAdmin()
          || (name == 'meta' && isTeacher()));
        // 班级设定和练习册：建立班级的老师
        allow create, update: if signed() && small() && gid.matches('cls_.*') && teacherDoc(name) && isTeacher() && teacherOk(gid)
          && (name != 'meta' || request.resource.data.get('owner', null) == request.auth.uid);
        // 学生纪录（u_…）和学生分享给老师的练习册（u_…_b_…）：老师，或学生自己的
        allow create, update: if signed() && small() && gid.matches('cls_.*') && !teacherDoc(name)
          && (ownsClass(gid) || isAdmin() || (inClass(gid) && (stu().get('docs', {}).get(gid, '') == name
              || (stu().get('docs', {}).get(gid, '') != '' && name.matches(stu().get('docs', {}).get(gid, '') + '_b_.*')))));
        allow delete: if false;
      }

      // 旧版学生密码的「钥匙」（已停用，只留着读）
      match /keys/{k} {
        allow get: if signed();
        allow list, create, update, delete: if false;
      }
    }
  }
}
